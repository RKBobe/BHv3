# Database Configuration
# Required: Connection string for the Supabase PostgreSQL database
SUPABASE_CONNECTION_STRING="postgresql://user:password@host:port/dbname"

# Security Configuration
# Optional: Secret key for JWT token generation.
# If not set, a temporary random key will be generated on startup (tokens will be invalid after restart).
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY="your_long_random_secret_key_here"
